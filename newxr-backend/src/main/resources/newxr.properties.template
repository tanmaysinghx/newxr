# =====================================================================================
#  Newxr configuration
# =====================================================================================
#
#  Everything here is optional. Out of the box Newxr runs on an embedded H2 database and
#  the setup wizard (open the server in a browser) asks for the license, your database,
#  your administrator and sign-in method, Kafka and your organization.
#
#  Prefer files to the wizard? Uncomment what you need and restart. Values here override
#  the built-in defaults; environment variables and --command-line arguments override this
#  file. Use a different file with:  java -jar newxr.jar --config=/etc/newxr/newxr.properties
#
#  The setup wizard and Administration -> Database edit this file in place: they change only
#  the keys they own and keep the rest of it, comments included.
#
#  This file can hold your database password. Keep it readable by the service account only.
# =====================================================================================


# --- Public address ------------------------------------------------------------------
# The URL users reach this server on, exactly as browsers see it (https:// behind a proxy).
# Used for Portal SSO redirect URIs and links in notifications.
# newxr.public-url=https://newxr.example.com
# server.port=8080


# --- Database ------------------------------------------------------------------------
# Leave commented to use the embedded H2 database in <newxr home>/data. Fine for a trial
# or a small team; use PostgreSQL or MySQL for production. Tables are created on first
# start against an empty database.
#
# PostgreSQL 15+
# spring.datasource.url=jdbc:postgresql://localhost:5432/newxr
# spring.datasource.username=newxr
# spring.datasource.password=change-me
#
# MySQL 8.0+ / MariaDB
# spring.datasource.url=jdbc:mysql://localhost:3306/newxr
# spring.datasource.username=newxr
# spring.datasource.password=change-me


# --- First administrator (skip the wizard entirely) ----------------------------------
# With both set, the administrator is created at startup and no setup key is issued.
# Starting this way also accepts the Apache License 2.0 on the operator's behalf.
# Password: at least 12 characters with upper case, lower case and a digit.
# REMOVE both once you have signed in.
# newxr.bootstrap.admin-email=admin@example.com
# newxr.bootstrap.admin-password=


# --- Sign-in with Portal SSO (optional) ----------------------------------------------
# Used only until an administrator saves sign-in settings in the console; after that the
# console owns them. Register Newxr in Portal SSO with redirect URI
#   <public-url>/login/oauth2/code/portal
# newxr.sso.portal.issuer-url=https://sso.example.com
# newxr.sso.portal.client-id=newxr
# newxr.sso.portal.client-secret=
# newxr.sso.builtin-enabled=true


# --- Kafka (optional) ----------------------------------------------------------------
# Every change (issue created, page published, alert raised ...) is published as JSON to
# <topic-prefix>.events. Like sign-in, the console owns these once saved there.
# newxr.kafka.bootstrap-servers=kafka-1:9092,kafka-2:9092
# newxr.kafka.topic-prefix=newxr
# newxr.kafka.security-protocol=PLAINTEXT
# newxr.kafka.sasl-mechanism=PLAIN
# newxr.kafka.username=
# newxr.kafka.password=


# --- At-rest key ---------------------------------------------------------------------
# Encrypts stored secrets (Portal SSO client secret, Kafka password). Generated into
# <newxr home>/secrets/master.key when unset. Back it up with your database.
# newxr.security.master-key=
