# Copy to .env and adjust. Used by compose.yaml.

# Port on the host.
NEWXR_PORT=8080

# Address users reach Newxr on, exactly as browsers see it (https:// behind a proxy).
# Needed for Portal SSO redirect URIs and links in notifications.
NEWXR_PUBLIC_URL=http://localhost:8080

# PostgreSQL. Pick a long random password.
POSTGRES_DB=newxr
POSTGRES_USER=newxr
POSTGRES_PASSWORD=

# JVM options for the Newxr container.
JAVA_OPTS=-XX:MaxRAMPercentage=75
