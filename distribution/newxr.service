# systemd unit for Newxr. install.sh fills in @JAVA@, @USER@, @HOME@ and @PORT@.
[Unit]
Description=Newxr — self-hosted suite for software, knowledge, service and operations teams
Documentation=https://github.com/tanmaysinghx/newxr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
Environment=NEWXR_HOME=@HOME@
Environment="JAVA_OPTS=-Xms256m -Xmx1g"
ExecStart=/bin/sh -c 'exec @JAVA@ $JAVA_OPTS -jar /opt/newxr/newxr.jar --httpPort=@PORT@'
WorkingDirectory=@HOME@
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
# Hardening: Newxr only writes to its home directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@HOME@
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
